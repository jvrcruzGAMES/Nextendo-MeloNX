# Nextendo Network Configuration & Secrets
# Values defined here or passed via GitHub Secrets are extracted by build.sh
# and compiled into the app binary as build constants (NextendoSecrets.swift).
# Do NOT commit your real .env file with secrets to source control.

# Nextendo OAuth Public Client ID (e.g. nxc_... registered on Nextendo)
# If left empty, Nextendo OAuth will be completely disabled in the build.
NEXTENDO_OAUTH_CLIENT_ID=

# Nextendo Infrastructure IPs (Optional build constants)
# If left empty or missing, these will automatically default to 127.0.0.1.
NEXTENDO_SERVER_IP=127.0.0.1
NEXTENDO_NAT_IP=127.0.0.1

# Nextendo Endpoints & OAuth
NEXTENDO_SERVER_URL=https://nextendo.network
NEXTENDO_REDIRECT_URI=melonx://oauth/callback
# Supported scopes matching Ryujinx-Nextendo:
NEXTENDO_OAUTH_SCOPES=identity friends sauvegardes history presence

